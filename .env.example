# Copy this file to .env and replace every placeholder locally.
# Do not commit the resulting .env file.
DB_URL=jdbc:mysql://localhost:3306/file_nest
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
# Use a long, random value (at least 32 bytes) in production.
JWT_SECRET=replace-with-a-long-random-jwt-signing-key
JWT_EXPIRATION=86400000
